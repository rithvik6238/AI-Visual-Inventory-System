generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Shelf {
  id        String    @id @default(uuid())
  name      String
  location  String
  status    String    @default("OK") // "OK", "LOW_STOCK", "MISPLACED"
  products  Product[]
  alerts    Alert[]
  scans     Scan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  shelfId     String
  shelf       Shelf    @relation(fields: [shelfId], references: [id])
  name        String
  sku         String   @unique
  count       Int
  capacity    Int      @default(20)
  confidence  Float    @default(0.0)
  lastUpdated DateTime @updatedAt
}

model Alert {
  id        String   @id @default(uuid())
  shelfId   String
  shelf     Shelf    @relation(fields: [shelfId], references: [id])
  type      String   // "LOW_STOCK", "MISPLACED_ITEM", "SUSPICIOUS_ACTIVITY"
  message   String
  severity  String   // "HIGH", "MEDIUM", "LOW"
  status    String   @default("UNRESOLVED") // "UNRESOLVED", "RESOLVED"
  createdAt DateTime @default(now())
}

model Scan {
  id          String   @id @default(uuid())
  shelfId     String
  shelf       Shelf    @relation(fields: [shelfId], references: [id])
  imageUrl    String
  detections  String   // JSON string of bounding boxes/detections
  createdAt   DateTime @default(now())
}
